rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each home shares a secret Home Group Code (e.g. WE-HOME-7429)
    // Authenticated users (including Anonymous Auth) who know the group code can read & sync.
    match /homes/{groupCode} {
      allow read, write: if request.auth != null
        && groupCode.size() >= 6
        && groupCode.size() <= 32;

      match /devices/{deviceId} {
        allow read, write: if request.auth != null
          && groupCode.size() >= 6
          && groupCode.size() <= 32;
      }
    }
  }
}
